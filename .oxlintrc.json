// oxlint 配置（允许注释）
// 文档：https://oxc.rs/docs/guide/usage/linter/config.html
// 规则表（含是否可自动修复）：https://oxc.rs/docs/guide/usage/linter/rules.html
//
// 分工：排版 / import 语句顺序交给 oxfmt（见 .oxfmtrc.jsonc）；
//       这里负责"语义 + 可自动修复的写法统一"。
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // 内置插件。注意：一旦写了 plugins，就会覆盖默认插件集合，必须把自己要的写全。
  // typescript / unicorn / oxc 是默认就有的；这里额外加 import（ESM 问题）和 react（React 19 规则）。
  "plugins": ["typescript", "unicorn", "oxc", "import", "react"],

  // 按"类别"批量开关，避免逐条列几百条规则。
  // correctness（确定是错）报 error；suspicious/perf（大概率是问题）报 warn 不挡路；
  // style/pedantic/restriction/nursery 关掉，需要的单条在下面显式打开。
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "restriction": "off",
    "pedantic": "off",
    "style": "off",
    "nursery": "off"
  },

  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },

  "options": {
    // 清理已经失效的 oxlint-disable 注释，防止"假豁免"越积越多
    "reportUnusedDisableDirectives": "warn"
  },

  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "out",
    ".next",
    ".turbo",
    ".content-collections",
    "coverage",
    "*.d.ts",
    "**/routeTree.gen.ts",
    ".wrangler",
    "films",
    "design"
  ],

  "rules": {
    // ───── 现有项目约定（保留）─────
    "no-console": "off",
    "no-debugger": "error",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],

    // ───── import 具名导入内部排序（可自动修复）─────
    // 只排 { b, a } → { a, b }；语句之间的分组/顺序由 oxfmt 的 sortImports 负责，
    // 所以这里必须 ignoreDeclarationSort: true，否则两个工具会互相打架、每次运行都改一遍。
    "sort-imports": ["error", { "ignoreDeclarationSort": true, "ignoreMemberSort": false, "ignoreCase": true }],

    // ───── 可自动修复的写法统一（`pnpm lint:fix` 或编辑器保存时自动改）─────
    "arrow-body-style": ["warn", "as-needed"], // () => { return x }  →  () => x
    "object-shorthand": "warn", // { foo: foo }  →  { foo }
    "prefer-template": "warn", // "a" + b  →  `a${b}`
    "prefer-object-spread": "warn", // Object.assign({}, a)  →  { ...a }
    "prefer-const": "warn", // 不再重新赋值就用 const
    "no-var": "error", // 禁止 var
    "unicorn/prefer-node-protocol": "warn", // require("fs") / from "fs"  →  "node:fs"
    "import/no-duplicates": "warn", // 同一个模块 import 了两次
    // 配合 tsconfig 的 verbatimModuleSyntax：只作类型使用的导入必须写成 `import type`
    "typescript/consistent-type-imports": ["warn", { "prefer": "type-imports", "fixStyle": "separate-type-imports" }],

    // ───── React 19 / 新 JSX transform ─────
    // 新版 JSX transform 不需要在文件里 import React，这条规则在这里只会制造 1500+ 条误报。
    "react/react-in-jsx-scope": "off",
    // 下面几条是 React Compiler 时代的正确性规则，规则本身有价值但目前存量代码会报错，
    // 先降为 warn 做提示；把存量改干净后再删掉这几行即回到 correctness 的 error。
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/purity": "warn",
    "react/immutability": "warn",
    "react/exhaustive-deps": "warn"
  }
}
