{
  "name": "@mykaoyan/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src",
    "scripts",
    "tsconfig.runtime.json"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "backup": "node scripts/backup.mjs backup",
    "restore": "node scripts/backup.mjs restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@mykaoyan/core": "workspace:*",
    "@mykaoyan/db": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0"
  }
}
